ANPR_VISIONZENITH_AUTO_LED_ENABLED=true
ANPR_CONTROL_BOARD_RUNTIME_INTERVAL_SECONDS=30
ANPR_RECOGNITION_MEDIA_DIR=var/recognition-media
ANPR_RECOGNITION_CORRELATION_SECONDS=10
ANPR_RECOGNITION_PAGE_SIZE=50
ANPR_RECOGNITION_MAX_IMAGE_BYTES=8388608
