ANPR_DB_USER=anpr_app
ANPR_DB_PASSWORD=CHANGE_ME

ANPR_MQTT_HOST=127.0.0.1
ANPR_MQTT_PORT=1883
ANPR_MQTT_USERNAME=
ANPR_MQTT_PASSWORD=
ANPR_MQTT_CLIENT_ID=anpr-central
ANPR_MQTT_ENABLED=true
ANPR_MQTT_HEARTBEAT_TIMEOUT_SECONDS=45
ANPR_VISIONZENITH_BV=17932
ANPR_VISIONZENITH_SERIAL_CHANNEL=0
