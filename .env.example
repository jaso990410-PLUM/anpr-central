ANPR_DEFAULT_SITE_CODE=MAIN

# Generate a unique value for each deployment (at least 32 characters).
ANPR_SECRET_KEY=replace-with-a-long-random-secret-key
ANPR_SESSION_COOKIE_NAME=anpr_session
ANPR_CSRF_COOKIE_NAME=anpr_login_csrf
ANPR_CSRF_LIFETIME_MINUTES=30
ANPR_SESSION_LIFETIME_MINUTES=480
ANPR_SESSION_IDLE_MINUTES=30
ANPR_COOKIE_SECURE=false
ANPR_LOGIN_MAX_FAILURES=5
ANPR_LOGIN_LOCK_MINUTES=15
ANPR_ENABLE_DOCS=false
